# Copy to .env and fill in what you use. CLI flags override these.

# Hosted: Groq (free tier). If set, it's the default provider.
GROQ_API_KEY=

# Or a local OpenAI-compatible server (llama.cpp, LM Studio, vLLM):
# LLM_PROVIDER=local
# LLM_BASE_URL=http://127.0.0.1:8080/v1
# LLM_API_KEY=            # only if the server was started with --api-key
# LLM_MODEL=              # auto-detected from /v1/models when empty

# Different models for the cheap review pass and the fix pass:
# LLM_TRIAGE_MODEL=
# LLM_FIX_MODEL=

# Extra JSON merged into every request body, e.g. to turn thinking back on:
# LLM_EXTRA_BODY={"chat_template_kwargs": {"enable_thinking": true}}
